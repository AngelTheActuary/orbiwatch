{
  "name": "orbitwatch",
  "version": "0.1.0",
  "description": "Visualización y análisis didáctico de objetos y desechos espaciales en órbita (SDA) con SGP4.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/check-setup.mjs",
    "dev": "tsx scripts/copy-cesium.ts && vite",
    "prebuild": "node scripts/check-setup.mjs",
    "build": "tsx scripts/copy-cesium.ts && vite build",
    "preview": "vite preview --outDir ../dist",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/check-setup.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "predemo": "node scripts/check-setup.mjs",
    "demo": "tsx scripts/demo.ts",
    "prefetch:sample": "node scripts/check-setup.mjs",
    "fetch:sample": "tsx scripts/fetch-sample.ts",
    "prebuild:catalog": "node scripts/check-setup.mjs",
    "build:catalog": "tsx scripts/build-catalog.ts",
    "precheck": "node scripts/check-setup.mjs",
    "check": "npm run typecheck && npm run test",
    "start": "npm run dev"
  },
  "dependencies": {
    "satellite.js": "^7.1.0",
    "cesium": "^1.146.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
